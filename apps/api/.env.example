# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── Supabase ─────────────────────────────────────────────────
# 在 Supabase Dashboard > Settings > API 中获取
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Drizzle ORM) ────────────────────────────────────
# 在 Supabase Dashboard > Settings > Database > Connection string 中获取
# 选择 "URI" 格式，Mode 选 "Transaction" (端口 6543) 或 "Session" (端口 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── CORS ─────────────────────────────────────────────────────
# 生产环境填写前端域名，多个用逗号分隔
# 例如: https://vibewriting.vercel.app,https://vibewriting.com
ALLOWED_ORIGINS=http://localhost:5173
