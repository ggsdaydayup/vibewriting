# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── JWT（自定义认证，无需 Supabase）────────────────────────────
# 生产环境请使用随机强密钥：openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret

# ── Database ──────────────────────────────────────────────────
# 支持任意 PostgreSQL，包括：
#   阿里云 RDS: postgresql://user:pass@rm-xxx.mysql.rds.aliyuncs.com:5432/dbname
#   腾讯云 TDSQL-PG: postgresql://user:pass@gz-xxx.sql.tencentcdb.com:5432/dbname
#   本地 Docker: postgresql://postgres:postgres@localhost:5432/vibewriting
DATABASE_URL=postgresql://user:password@host:5432/vibewriting

# ── CORS ─────────────────────────────────────────────────────
# 生产环境填写前端域名（不要带尾部斜杠）
ALLOWED_ORIGINS=http://localhost:5173
